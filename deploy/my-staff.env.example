# Copy this file to /etc/my-staff/my-staff.env (chmod 600, root-owned) and
# fill in real values. Never commit the real file to git.

# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=false

# Only set this to true if the app is genuinely only reachable over plain
# HTTP with no TLS anywhere in the path (e.g. an internal-only LAN/VPN
# deployment). It disables the Secure flag on session cookies so login
# still works without HTTPS — but the tradeoff is real: session cookies,
# passwords, and PINs travel in cleartext and can be read by anyone who
# can observe traffic on that network segment. For anything reachable
# from outside a trusted LAN, put TLS in front (see deploy/nginx/ notes)
# and leave this unset/false instead.
FORCE_HTTP_COOKIES=true
