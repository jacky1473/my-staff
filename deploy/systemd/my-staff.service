[Unit]
Description=my-staff — attendance & workforce portal (Docker container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0

# Bound to 127.0.0.1 only — nginx is the public-facing side on port 80.
# Container is never exposed directly to the network.
ExecStartPre=-/usr/bin/docker stop my-staff
ExecStartPre=-/usr/bin/docker rm my-staff
ExecStart=/usr/bin/docker run --rm --name my-staff \
  --env-file /etc/my-staff/my-staff.env \
  -p 127.0.0.1:5000:5000 \
  -v /var/lib/my-staff/data:/data \
  my-staff:latest
ExecStop=/usr/bin/docker stop -t 10 my-staff

[Install]
WantedBy=multi-user.target
