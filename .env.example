# Application Security
SECRET_KEY=c12c129751a2f548895bbbc518289aef93a56b6125d44965a84ea5c90dcdac0c
FLASK_DEBUG=false
PYTHONUNBUFFERED=1

# Database Configuration
# Default paths: /data/attendance_staging.db (staging) or /data/attendance.db (production)
# DB_PATH=/data/attendance_staging.db

# Fallback email if user account doesn't have an email assigned
DEFAULT_TEST_EMAIL=ahmedfarman102@gmail.com

# -----------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (For 2FA Verification Code / OTP)
# -----------------------------------------------------------------------------

# --- OPTION 1: GMAIL CONFIGURATION (Recommended) ---
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Search for "App Passwords" and create one named "Attendance App"
# 3. Paste the generated 16-character password into SMTP_PASS below (no spaces needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Attendance Portal <your-email@gmail.com>
SMTP_TLS=true

# --- OPTION 2: MICROSOFT 365 / OUTLOOK ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your-email@company.com
# SMTP_PASS=your-password
# SMTP_FROM=Attendance Portal <your-email@company.com>
# SMTP_TLS=true

# --- OPTION 3: SENDGRID / CUSTOM SMTP ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# SMTP_FROM=Attendance Portal <noreply@yourdomain.com>
# SMTP_TLS=true
