# ==============================================================================
# Staff Attendance & HR Management Portal - Configuration
# ==============================================================================
# Copy this file to '.env' and modify the values as needed.

# Flask Application Secret Key (Required in Production)
# Generate a new secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Server Port (Default: 5000)
PORT=5000

# Flask Debug Mode (Set to false in production)
FLASK_DEBUG=false

# Database Storage Path (Optional - defaults to persistent auto-detected path)
# DB_PATH=./attendance.db

# Automated Backup Storage Directory (Optional)
# BACKUP_DIR=./backups
